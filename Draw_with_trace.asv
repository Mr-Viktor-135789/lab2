function Draw_column_division(Params, LogLanguage)
%DRAW_COLUMN_DIVISION  Перемежитель (таблицей) + LDPC "делением в столбик" (GF(2)).
%   Запуск:
%       Draw_column_division
%       Draw_column_division(Params, 'ru')

    clc;
    if nargin < 2 || isempty(LogLanguage), LogLanguage = 'ru'; end
    if nargin < 1 || isempty(Params)
        Params = struct();
        Params.Interleaver.isTransparent = false;
        Params.Encoder.isTransparent     = true;
        Params.Sig.Modulation            = '32APSK';
        Params.Common.Trace              = 2;
    end

    % ================= 1. ПЕРЕМЕЖИТЕЛЬ =================
    il = ClassInterleaver(Params, LogLanguage);
    InData_ilv  = randi([0 1], 1, 20);
    OutData_ilv = il.StepTx(InData_ilv);

    fprintf('\n=== ПЕРЕМЕЖИТЕЛЬ (5 столбцов, 32APSK) ===\n');
    fprintf('вход : %s\n', num2str(InData_ilv));
    fprintf('выход: %s\n', num2str(OutData_ilv));

    C = 5;
    R = numel(InData_ilv) / C;
    Mmat = reshape(InData_ilv, C, R).';   % запись по столбцам, чтение по строкам

    fprintf('\nВход перемежителя как таблица (%d строк × %d столбцов):\n', R, C);
    try
        T = array2table(Mmat, ...
            'VariableNames', compose('col%d', 1:C), ...
            'RowNames',      compose('row%d', 1:R));
        disp(T);
    catch
        fprintf('        '); fprintf('col%-4d', 1:C); fprintf('\n');
        fprintf('       %s\n', repmat('------', 1, C));
        for r = 1:R
            fprintf('  row%-2d ', r); fprintf('  %-4d', Mmat(r,:)); fprintf('\n');
        end
    end

    % ================= 2. LDPC "ДЕЛЕНИЕ В СТОЛБИК" =================
    fprintf('\n=== LDPC: деление в столбик (GF(2)) ===\n');
    ldpcColumnDivision();

    % ================= 3. КАСКАД (опционально) =================
    if isfield(Params,'Encoder') && ~Params.Encoder.isTransparent
        fprintf('\n=== КАСКАД BCH+LDPC ===\n');
        enc = ClassEncoder(Params, LogLanguage);
        enc.Mode = 'BCH+LDPC';
        InData_enc = randi([0 1], 53840, 1);
        code3      = enc.StepTx(InData_enc);
        fprintf('%d -> %d бит (rate = %.4f)\n', ...
            numel(InData_enc), numel(code3), numel(InData_enc)/numel(code3));
    end

    fprintf('\nГотово (только командное окно).\n');
end

% =====================================================================
% LDPC как "деление в столбик" в GF(2):
%   делимое  = группа u (NB бит)            — старший бит слева
%   делитель = адреса a из ct1/ct2          — задают позиции старших единиц
%   шаг      = XOR сдвинутой копии делителя в acc
%   остаток  = acc (M бит)
%   приведение остатка = p = cumXOR(acc)
% =====================================================================
function ldpcColumnDivision()
    NB = 6; Q = 2; M = 6;
    ct1 = [0 1 3 5; 1 0 2 4];
    ct2 = [0 2 5];
    nRows = size(ct1,1) + size(ct2,1);

    u = [1 0 1 1 0 1, ...
         0 1 0 0 1 1, ...
         1 1 0 1 0 1];

    fprintf('u = %s  (%d бит = %d групп × %d)\n', ...
        num2str(u), numel(u), nRows, NB);
    fprintf('NB=%d  Q=%d  M=%d  строк=%d\n', NB, Q, M, nRows);
    fprintf('ct1 = %s\n', mat2str(ct1));
    fprintf('ct2 = %s\n', mat2str(ct2));

    acc = zeros(1, M);
    tabs = {ct1, ct2};
    rowId = 0;

    for t = 1:2
        for g = 1:size(tabs{t},1)
            a    = tabs{t}(g,2:end);
            base = rowId*NB;
            grp  = u(base+1 : base+NB);

            fprintf('\n========== строка %d ==========\n', rowId);
            fprintf('  делимое  (группа u[%d..%d]) = %s\n', ...
                base, base+NB-1, num2str(grp));
            fprintf('  делитель (адреса a)          = %s\n', num2str(a));
            fprintf('  начальный остаток acc        = %s\n', num2str(acc));

            % --- пошаговое деление: для каждой единицы делимого ---
            for i = 0:NB-1
                if grp(i+1)
                    % "старший бит" делимого на позиции i:
                    % XOR-им делитель, сдвинутый на i*Q
                    shifted = mod(a + i*Q, M) + 1;
                    before  = acc;
                    acc(shifted) = xor(acc(shifted), 1);
                    fprintf('    [шаг] u[%d]=1: делитель сдвинут на %d*Q=%d -> позиции %s\n', ...
                        i, i, i*Q, num2str(shifted));
                    fprintf('          acc: %s  XOR  %s  =  %s\n', ...
                        num2str(before), num2str(shifted_bits(M, shifted)), ...
                        num2str(acc));
                end
            end

            fprintf('  остаток acc                 = %s\n', num2str(acc));
            rowId = rowId + 1;
        end
    end

    % --- приведение остатка к p (cumXOR) ---
    p = zeros(1,M); p(1) = acc(1);
    fprintf('\n--- приведение остатка: p = cumXOR(acc) ---\n');
    fprintf('  p(1) = acc(1) = %d\n', acc(1));
    for i = 2:M
        p(i) = xor(acc(i), p(i-1));
        fprintf('  p(%d) = acc(%d) XOR p(%d) = %d XOR %d = %d\n', ...
            i, i, i-1, acc(i), p(i-1), p(i));
    end

    fprintf('\nacc = %s\n', num2str(acc));
    fprintf('p   = %s\n', num2str(p));
    fprintf('[u, p] = %s  (%d бит)\n', num2str([u, p]), numel(u)+numel(p));

    ok = (p(1) == acc(1)) && all(p(2:end) == xor(acc(2:end), p(1:end-1)));
    fprintf('Проверка p(i)=acc(i) XOR p(i-1): %s\n', ternary(ok,'OK','FAIL'));

    % --- краткая сводка по строкам ---
    fprintf('\n--- СВОДКА ПО СТРОКАМ ---\n');
    rowId = 0;
    for t = 1:2
        for g = 1:size(tabs{t},1)
            a    = tabs{t}(g,2:end);
            base = rowId*NB;
            grp  = u(base+1 : base+NB);
            fprintf('строка %d: u[%2d..%2d]=%s  a=%s\n', ...
                rowId, base, base+NB-1, num2str(grp), num2str(a));
            rowId = rowId + 1;
        end
    end
end

% Вспомогательная: битовая маска M-разрядного вектора по позициям pos
function bits = shifted_bits(M, pos)
    bits = zeros(1, M);
    bits(pos) = 1;
end

function s = ternary(cond, a, b)
    if cond, s = a; else, s = b; end
end