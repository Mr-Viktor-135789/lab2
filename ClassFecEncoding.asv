clc;
clear;

%% Входные данные
InData = [1 0 1 1 0];

%% Параметры
Params.Encoder.isTransparent = false;
Params.Encoder.Date = [];

%% 1. Собственный кодер
enc = ClassEncoder(Params, 'en');
code = enc.StepTx(InData);
disp('Собственный код:');
disp(code);

%% 2. Встроенный genpoly
[genpoly, t] = bchgenpoly(15, 5);
gp = genpoly.x;
disp('Встроенный genpoly:');
disp(gp);

ref_code = double(bchenc(gf(InData), 15, 5).x);
disp(ref_code);

%% 5. Сравнение
fprintf('enc == ref_code: %d\n', isequal(code, ref_code));

%% 5. Декодирование (если есть декодер)
if exist('il', 'var')
    OutData = il.StepRx(code);
    disp('Декодированные данные:');
    disp(OutData);
end